{
  "name": "minisuper-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Punto de venta e inventario de escritorio para un minisuper.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n BACKEND,DESKTOP -c blue,green \"npm run dev --workspace=@minisuper/backend\" \"npm run dev --workspace=@minisuper/desktop\"",
    "dev:backend": "npm run dev --workspace=@minisuper/backend",
    "dev:desktop": "npm run dev --workspace=@minisuper/desktop",
    "build": "npm run build --workspace=@minisuper/desktop",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@minisuper/backend",
    "prisma:format": "npm run prisma:format --workspace=@minisuper/backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
